{
    "swagger": "2.0",
    "info": {
        "description": "Execução e Produção da oficina: fila de diagnóstico e reparo, consumida pelo mecânico. Parte da saga orquestrada pelo os-service (Tech Challenge FIAP SOAT — Fase 4).",
        "title": "Execution Service API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/executions/queue": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Sem filtro: execuções em queued_repair (primeiro) e depois queued_diagnosis, mais antigas primeiro em cada raia. Com status: lista só aquela raia (status ativos: queued_diagnosis, in_diagnosis, diagnosed, queued_repair, in_repair).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "executions"
                ],
                "summary": "Fila de trabalho do mecânico",
                "parameters": [
                    {
                        "enum": [
                            "queued_diagnosis",
                            "in_diagnosis",
                            "diagnosed",
                            "queued_repair",
                            "in_repair"
                        ],
                        "type": "string",
                        "description": "Filtra por um status ativo",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Máximo de itens (1-200, padrão 50)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/executionhandler.QueueResponse"
                        }
                    },
                    "400": {
                        "description": "VALIDATION_ERROR / INVALID_STATUS",
                        "schema": {
                            "$ref": "#/definitions/httputil.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED",
                        "schema": {
                            "$ref": "#/definitions/httputil.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "FORBIDDEN",
                        "schema": {
                            "$ref": "#/definitions/httputil.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/executions/{os_id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Estado atual e linha do tempo da execução da OS. Também é consumido pela API composition do os-service.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "executions"
                ],
                "summary": "Detalhe da execução",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID da ordem de serviço (UUID)",
                        "name": "os_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/executionhandler.ExecutionDetailsResponse"
                        }
                    },
                    "400": {
                        "description": "VALIDATION_ERROR (os_id não é UUID ou corpo inválido)",
                        "schema": {
                            "$ref": "#/definitions/httputil.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED",
                        "schema": {
                            "$ref": "#/definitions/httputil.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "FORBIDDEN",
                        "schema": {
                            "$ref": "#/definitions/httputil.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "EXECUTION_NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/httputil.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/executions/{os_id}/diagnosis/complete": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "in_diagnosis → diagnosed com os serviços e peças necessários. Publica execution.DiagnosisCompleted (a saga reserva as peças e pede o orçamento).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "executions"
                ],
                "summary": "Concluir diagnóstico",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID da ordem de serviço (UUID)",
                        "name": "os_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Correlação propagada para o evento",
                        "name": "X-Correlation-ID",
                        "in": "header"
                    },
                    {
                        "description": "Serviços e peças",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/executionhandler.CompleteDiagnosisRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/executionhandler.ExecutionResponse"
                        }
                    },
                    "400": {
                        "description": "VALIDATION_ERROR (os_id não é UUID ou corpo inválido)",
                        "schema": {
                            "$ref": "#/definitions/httputil.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED",
                        "schema": {
                            "$ref": "#/definitions/httputil.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "FORBIDDEN",
                        "schema": {
                            "$ref": "#/definitions/httputil.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "EXECUTION_NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/httputil.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "INVALID_TRANSITION / CONCURRENT_UPDATE",
                        "schema": {
                            "$ref": "#/definitions/httputil.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "INVALID_DIAGNOSIS",
                        "schema": {
                            "$ref": "#/definitions/httputil.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/executions/{os_id}/diagnosis/start": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "queued_diagnosis → in_diagnosis. Publica execution.DiagnosisStarted.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "executions"
                ],
                "summary": "Iniciar diagnóstico",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID da ordem de serviço (UUID)",
                        "name": "os_id",
