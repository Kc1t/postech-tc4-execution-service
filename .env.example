APP_PORT=8080
# development | prod (em prod o JWT_SECRET padrão é recusado)
APP_ENV=development
LOG_LEVEL=info
NEW_RELIC_APP_NAME=execution-service-local
# Sem chave o agente fica desligado e o serviço funciona normalmente.
NEW_RELIC_LICENSE_KEY=

# Mesmo segredo HS256 do os-service e da Lambda de autenticação.
JWT_SECRET=change-me-in-production
# Origens do navegador permitidas (separadas por vírgula; nunca "*")
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AWS. Em dev aponta para o LocalStack do docker-compose (porta 4568); no EKS,
# AWS_ENDPOINT_URL fica vazio e as credenciais vêm do role do node.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4568
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
DYNAMODB_TABLE=executions
SQS_EXECUTION_COMMANDS_URL=http://localhost:4568/000000000000/execution-commands
SNS_EXECUTION_EVENTS_ARN=arn:aws:sns:us-east-1:000000000000:execution-events

# Reparos simultâneos aceitos (queued_repair + in_repair); acima disso o StartRepair é recusado.
MAX_CONCURRENT_REPAIRS=10
# Habilita o campo simulate_failure=repair dos comandos para demonstrar compensações
FAULT_INJECTION_ENABLED=false

# Intervalo do relay do outbox e tempo máximo do graceful shutdown
OUTBOX_POLL_INTERVAL=500ms
SHUTDOWN_TIMEOUT=20s
